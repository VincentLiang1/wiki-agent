@echo off
chcp 65001 >nul
setlocal EnableExtensions
rem Friend's Windows: install Git/uv, get the program, uv sync, UTF-8 mode, long paths, then scripts\winsetup.py
rem asks the questions, writes the config, stores the mail password and installs the schedule. Safe to rerun.
rem Three languages: saved as UTF-8 with chcp 65001. Under 65001 cmd misreads lines next to non-ASCII text
rem (half a line runs as a command), so Chinese may appear ONLY inside the quoted arguments of call :msg /
rem call :pick - not in rem, not in echo. The zh-Hans column is generated by scripts\l10n_sync.py.
call :lang
call :pick T "wiki-feeder 安裝" "wiki-feeder 安装" "wiki-feeder Setup"
title %T%
echo.
echo ==================================================
call :msg "  wiki-feeder 安裝（第一次安裝、重新設定都用這個）" "  wiki-feeder 安装（第一次安装、重新设置都用这个）" "  wiki-feeder setup - for the first install and for changing settings"
echo ==================================================
echo.
call :msg "開始之前請先做好這三件事：" "开始之前请先做好这三件事：" "Before you start, please do these three things:"
call :msg "  1. 裝好 iCloud for Windows，打開「iCloud 雲碟」" "  1. 装好 iCloud for Windows，打开「iCloud 云盘」" "  1. Install iCloud for Windows and turn on iCloud Drive"
call :msg "  2. 裝好 Claude Code，開一個命令視窗打 claude，登入你自己的帳號" "  2. 装好 Claude Code，开一个命令窗口打 claude，登录你自己的账号" "  2. Install Claude Code, open a Command Prompt, type claude and sign in with your own account"
call :msg "  3. 照 meeting-scribe 的說明解壓縮、跑它的 Install.bat" "  3. 照 meeting-scribe 的说明解压缩、跑它的 Install.bat" "  3. Unzip meeting-scribe as its instructions say and run its Install.bat"
echo.
call :pause

rem ---- Git and uv ----
set "PATH=%PATH%;%ProgramFiles%\Git\cmd;%USERPROFILE%\.local\bin;%LOCALAPPDATA%\Microsoft\WinGet\Links"
where git >nul 2>nul
if errorlevel 1 (
  call :msg "安裝 Git..." "安装 Git..." "Installing Git..."
  winget install --id Git.Git -e --source winget --accept-package-agreements --accept-source-agreements
)
where git >nul 2>nul
if errorlevel 1 goto nogit
where uv >nul 2>nul
if errorlevel 1 (
  call :msg "安裝 uv..." "安装 uv..." "Installing uv..."
  winget install --id astral-sh.uv -e --source winget --accept-package-agreements --accept-source-agreements
)
where uv >nul 2>nul
if errorlevel 1 goto nouv

rem ---- the program: use this folder if it is the repo, otherwise clone ----
set "REPO=%~dp0"
if "%REPO:~-1%"=="\" set "REPO=%REPO:~0,-1%"
if exist "%REPO%\pyproject.toml" goto haverepo
set "REPO=C:\wiki-feeder"
set "ANS="
echo.
call :msg "程式要放在哪個資料夾？直接按 Enter = C:\wiki-feeder" "程序要放在哪个文件夹？直接按 Enter = C:\wiki-feeder" "Which folder should the program go in? Press Enter for C:\wiki-feeder"
set /p "ANS=> "
if not "%ANS%"=="" set "REPO=%ANS%"
if exist "%REPO%\pyproject.toml" goto haverepo
call :msg "從 GitHub 下載程式..." "从 GitHub 下载程序..." "Downloading the program from GitHub..."
git clone https://github.com/VincentLiang1/wiki-agent.git "%REPO%"
if errorlevel 1 goto noclone
:haverepo
cd /d "%REPO%"
echo.
call :msg "安裝程式需要的套件..." "安装程序需要的套件..." "Installing the packages the program needs..."
uv sync
if errorlevel 1 goto nosync

rem ---- UTF-8 mode: the program refuses to run without it ----
setx PYTHONUTF8 1 >nul
set "PYTHONUTF8=1"

rem ---- long paths: the only step that needs admin rights, so only this command is elevated ----
rem (running the whole .bat as admin would put the config and schedule under the admin account)
reg query "HKLM\SYSTEM\CurrentControlSet\Control\FileSystem" /v LongPathsEnabled 2>nul | findstr /c:"0x1" >nul
if errorlevel 1 (
  echo.
  call :msg "開啟 Windows 長路徑支援：等一下會跳出「使用者帳戶控制」，請按「是」" "打开 Windows 长路径支持：等一下会跳出「用户帐户控制」，请按「是」" "Turning on Windows long path support: a User Account Control window will pop up, please click Yes"
  powershell -NoProfile -Command "Start-Process reg -Verb RunAs -Wait -ArgumentList 'add','HKLM\SYSTEM\CurrentControlSet\Control\FileSystem','/v','LongPathsEnabled','/t','REG_DWORD','/d','1','/f'"
)
reg query "HKLM\SYSTEM\CurrentControlSet\Control\FileSystem" /v LongPathsEnabled 2>nul | findstr /c:"0x1" >nul
if errorlevel 1 call :msg "注意：長路徑沒有開成，檔名很長的檔可能會處理失敗。之後可以再跑一次 Install.bat" "注意：长路径没有开成，文件名很长的文件可能会处理失败。之后可以再跑一次 Install.bat" "Note: long path support is not on, so files with very long names may fail. You can run Install.bat again later"
git config --global core.longpaths true

rem ---- questions, config, schedule ----
echo.
uv run python -X utf8 scripts\winsetup.py
if errorlevel 1 goto setupfail
echo.
call :pause
exit /b 0

:nogit
echo.
call :msg "裝不起來 Git。請到 https://git-scm.com 下載安裝後，再跑一次 Install.bat" "装不起来 Git。请到 https://git-scm.com 下载安装后，再跑一次 Install.bat" "Could not install Git. Please download and install it from https://git-scm.com, then run Install.bat again"
call :pause
exit /b 1
:nouv
echo.
call :msg "裝不起來 uv。請到 https://docs.astral.sh/uv 照說明安裝後，再跑一次 Install.bat" "装不起来 uv。请到 https://docs.astral.sh/uv 照说明安装后，再跑一次 Install.bat" "Could not install uv. Please install it as https://docs.astral.sh/uv explains, then run Install.bat again"
call :pause
exit /b 1
:noclone
echo.
call :msg "下載不了程式。請確認網路正常，再跑一次 Install.bat。" "下载不了程序。请确认网络正常，再跑一次 Install.bat。" "Could not download the program. Please check your network, then run Install.bat again."
call :pause
exit /b 1
:nosync
echo.
call :msg "套件裝不起來（上面有錯誤訊息）。請確認網路正常後再跑一次 Install.bat" "套件装不起来（上面有错误消息）。请确认网络正常后再跑一次 Install.bat" "Could not install the packages - the error is shown above. Please check your network, then run Install.bat again"
call :pause
exit /b 1
:setupfail
echo.
call :msg "安裝沒有完成（原因在上面）。處理好之後再跑一次 Install.bat，已填好的設定可以沿用。" "安装没有完成（原因在上面）。处理好之后再跑一次 Install.bat，已填好的设置可以沿用。" "Setup did not finish - the reason is shown above. Fix it and run Install.bat again; you can reuse the answers you already gave."
call :pause
exit /b 1

rem ==== same in all three .bat files from here to the end - tests\test_winsetup.py ====
:lang
rem Language: [general] language in the config (chosen at setup); otherwise the Windows display language,
rem mapped the same way as i18n.detect. GetUserDefaultUILanguage, not Get-UICulture: that one follows
rem the console code page and reads en-US under 65001 even on Chinese Windows.
set "WL="
for /f "usebackq delims=" %%L in (`powershell -NoProfile -ExecutionPolicy Bypass -Command "$f=Join-Path $env:LOCALAPPDATA 'wiki-feeder\config.toml'; $l=''; if (Test-Path -LiteralPath $f) { $m=[regex]::Match([IO.File]::ReadAllText($f), '(?m)^\s*language\s*=\s*.(zh-Hant|zh-Hans|en)\W'); if ($m.Success) { $l=$m.Groups[1].Value } }; if (-not $l) { $q=[char]34; $k=Add-Type -Name K -Namespace WikiFeeder -PassThru -MemberDefinition ('[DllImport('+$q+'kernel32.dll'+$q+')] public static extern ushort GetUserDefaultUILanguage();'); $i=[int]$k::GetUserDefaultUILanguage(); $l='en'; if (($i -band 0x3FF) -eq 4) { $l='zh-Hant'; if ($i -eq 0x804 -or $i -eq 0x1004) { $l='zh-Hans' } } }; $l"`) do set "WL=%%L"
if not defined WL set "WL=zh-Hant"
exit /b
:msg
rem call :msg "zh-Hant" "zh-Hans" "English" - prints one line in language WL
set "M=%~1"
if "%WL%"=="zh-Hans" set "M=%~2"
if "%WL%"=="en" set "M=%~3"
echo(%M%
exit /b
:pick
rem call :pick VAR "zh-Hant" "zh-Hans" "English" - sets VAR in language WL
set "%~1=%~2"
if "%WL%"=="zh-Hans" set "%~1=%~3"
if "%WL%"=="en" set "%~1=%~4"
exit /b
:pause
rem cmd's own pause prompt is always English under 65001, so print our own
call :msg "請按任意鍵繼續 . . ." "请按任意键继续 . . ." "Press any key to continue . . ."
pause >nul
exit /b
